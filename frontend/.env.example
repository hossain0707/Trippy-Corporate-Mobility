VITE_API_BASE_URL=http://localhost:4000
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_MAPTILER_KEY=
# Social buttons: Google is enabled by default when this is unset.
# Set an empty value to hide all social buttons. Add others only when configured in Supabase.
VITE_SOCIAL_PROVIDERS=google
# Phone sign-in requires a verified SMS provider before enabling.
VITE_PHONE_AUTH=false
