# DEV ONLY: combined FastAPI + themed Vite UI, behind the existing Cloud Run IAP policy.
# Build args below are public browser values. Never put DB or merchant secrets here.
FROM node:22-bookworm-slim AS web
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit
COPY frontend/ ./
ARG VITE_API_BASE_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_DEV_GATE=true
ENV VITE_SOCIAL_PROVIDERS=google
ENV VITE_PHONE_AUTH=false
RUN test -n "$VITE_API_BASE_URL" && test -n "$VITE_SUPABASE_URL" && \
    test -n "$VITE_SUPABASE_PUBLISHABLE_KEY" && npm run check && npm run build

FROM python:3.12-slim AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /srv/backend
RUN groupadd -r app && useradd --no-log-init -r -g app app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
COPY backend/scripts ./scripts
COPY --from=web /build/dist ./web
USER app
EXPOSE 8000
CMD ["uvicorn","app.dev_site:app","--host","0.0.0.0","--port","8000","--proxy-headers","--forwarded-allow-ips","127.0.0.1"]
